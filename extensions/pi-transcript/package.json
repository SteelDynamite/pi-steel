{
  "name": "pi-transcript",
  "version": "0.2.2",
  "description": "Focused transcript and context-rewrite viewer for Pi Coding Agent.",
  "type": "module",
  "license": "MIT",
  "author": "SteelDynamite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteelDynamite/pi-transcript.git"
  },
  "bugs": {
    "url": "https://github.com/SteelDynamite/pi-transcript/issues"
  },
  "homepage": "https://github.com/SteelDynamite/pi-transcript#readme",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "transcript",
    "conversation"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:pack": "npm pack --dry-run --json",
    "validate": "npm run typecheck && npm test && npm run test:pack"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
