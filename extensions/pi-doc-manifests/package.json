{
  "name": "pi-doc-manifests",
  "version": "1.3.0",
  "description": "Initialize and refresh declarative manifests for trusted project documentation.",
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "documentation",
    "manifests"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "minimatch": "^10.2.5",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  }
}
